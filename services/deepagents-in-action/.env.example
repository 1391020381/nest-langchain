# 方式一：硅基流动（优先）。
SILICONFLOW_API_KEY=
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 方式二：其他兼容接口。不使用方式一时填写。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
DEEPAGENT_MODEL=

# 研究助手使用 Tavily 搜索，需单独配置。
TAVILY_API_KEY=

# 可选：LangSmith 调试与追踪。开启后上传问题、模型和工具的输入输出。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepagents-in-action-ch02
# 必须与账号区域一致；以下为默认 US 区域。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 多 workspace 的 API Key 可按需指定工作区 ID。
# LANGSMITH_WORKSPACE_ID=
