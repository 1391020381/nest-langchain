{
  "name": "@autix/chat",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "build": "rm -rf dist tsconfig.tsbuildinfo && nest build",
    "start": "bun run dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "demo:deepagent-hello": "bun run scripts/run-deepagent-hello.ts",
    "demo:deepagent-research": "bun run scripts/run-deepagent-research-demo.ts",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev"
  },
  "dependencies": {
    "@autix/contracts": "workspace:*",
    "@autix/llm-core": "workspace:*",
    "@langchain/core": "^1.2.4",
    "@langchain/openai": "1.5.5",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "bcrypt": "^6.0.0",
    "deepagents": "1.10.2",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.3",
    "dotenv": "^17.4.2",
    "prisma": "^7",
    "typescript": "^5.7.0"
  }
