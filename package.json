{
  "name": "root",
  "private": true,
  "workspaces": ["clients/*", "services/*", "packages/*"],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "clean:ports": "for port in 3000 3001 3002 4001; do lsof -ti :$port | xargs kill -9 2>/dev/null; done; echo 'Ports cleaned'",
    "dev": "bun run dev:deepagent",
    "dev:deepagent": "bun scripts/dev-deepagent.ts",
    "dev:deepagent-api": "bun scripts/dev-deepagent.ts api",
    "dev:deepagent-web": "bun scripts/dev-deepagent.ts web",
    "dev:legacy-chat": "bun run clean:ports && turbo run dev --parallel --filter=@autix/chat --filter=@autix/chat-web",
    "dev:chat-web": "turbo run dev --filter=@autix/chat-web",
    "dev:chat": "turbo run dev --filter=@autix/chat",
    "dev:api": "turbo run dev --filter=@autix/api",
    "dev:web": "turbo run dev --filter=@autix/web",
    "dev:langchain": "bun run clean:ports && turbo run dev --parallel --filter=@autix/api --filter=@autix/web",
    "build:deepagent": "turbo run build --filter=@autix/deepagent-api --filter=@autix/deepagent-web",
    "typecheck:deepagent": "turbo run typecheck --filter=@autix/deepagent-api --filter=@autix/deepagent-web",
    "test:deepagent": "turbo run test --filter=@autix/deepagent-api --filter=@autix/deepagent-web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.8.20",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "@langchain/openai": "1.5.5"
  }
}
