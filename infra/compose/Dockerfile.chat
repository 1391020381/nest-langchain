FROM oven/bun:1-alpine AS base
WORKDIR /app

COPY package.json bun.lock bunfig.toml turbo.json tsconfig.base.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/llm-core/package.json ./packages/llm-core/
COPY services/api/package.json ./services/api/
COPY services/chat/package.json ./services/chat/
COPY clients/chat-web/package.json ./clients/chat-web/
COPY clients/web/package.json ./clients/web/

RUN bun install --frozen-lockfile

COPY packages/contracts ./packages/contracts
COPY packages/llm-core ./packages/llm-core
COPY services/chat ./services/chat

RUN bunx prisma@6.19.3 generate \
    --schema=services/chat/prisma/schema.prisma
RUN bun run --filter=@autix/contracts build \
    && bun run --filter=@autix/llm-core build \
    && bun run --filter=@autix/chat build

FROM oven/bun:1-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4001

COPY --from=base /app/package.json ./
COPY --from=base /app/bun.lock ./
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/packages ./packages
COPY --from=base /app/services/chat ./services/chat

WORKDIR /app/services/chat
EXPOSE 4001
CMD ["bun", "run", "dist/main.js"]
